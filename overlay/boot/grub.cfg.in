set timeout=5
menuentry "Linux" {
    echo load kernel
    linux /vmlinuz splash panic=10 hardlockup_panic=1 softlockup_panic=1 hung_task_panic=1 ignore_loglevel iommu=igfx_off
    echo load initramfs
    initrd /initrd.cpio.gz /kernel_modules.cpio.gz
    echo boot
}

submenu "Power ->" --class power {
    menuentry "reboot" {
        reboot
    }

    menuentry "shutdown" {
        halt
    }

    menuentry "UEFI Firmware Setup" {
        fwsetup
    }
}

menuentry "USB Mass Storage" {
    linux /linux-usb-daget_ssh_123456.efi
}
